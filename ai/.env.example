# OpenAI API 키 (QA, RAG, OpenAlex, Wiki, YouTube 공통 사용)
OPENAI_API_KEY=sk

# 백엔드와 공유하는 내부 키 (backend env.properties의 INTERNAL_API_KEY와 같은 값)
INTERNAL_API_KEY=

# YouTube Data API 키
YOUTUBE_API_KEY=~
# 네이버 블로그 검색 API (네이버 클라우드 콘솔의 NAVER API HUB에서 Application 등록 후 인증 정보)
NAVER_CLIENT_ID=~
NAVER_CLIENT_SECRET=~

# Wikipedia API 요청에 사용할 User-Agent (선택)
WIKIKIT_USER_AGENT="WikiKit/1.0 (+https://github.com/~; contact: ~@~.com)"

# ChromaDB 텔레메트리 비활성화 (선택)
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY_ENABLED=False

# RAG 벡터 저장 경로 (선택, 기본값: ./chroma_data)
RAG_PERSIST_DIR=server_storage/chroma_data

# 강의 자료 분할 방식 (선택, 기본값: page). page | recursive | semantic
# RAG_CHUNK_STRATEGY=page

# LLM 모델 (선택, 기본값: gpt-6-luna). 용도별 LLM_SUMMARY_MODEL, LLM_QA_MODEL 등도 가능
# LLM_MODEL=gpt-6-luna

# 필수 키. 하나라도 비어 있으면 서버가 시작 단계에서 멈춤
# 같은 이름의 셸 환경변수가 있으면 이 파일보다 우선함

# OpenAI API 키 (요약, QnA, 추천 검색어·검증, 임베딩)
OPENAI_API_KEY=sk

# 백엔드와 공유하는 내부 키 (backend env.properties의 INTERNAL_API_KEY와 같은 값)
INTERNAL_API_KEY=

# YouTube Data API 키
YOUTUBE_API_KEY=~
# 네이버 블로그 검색 API (네이버 클라우드 콘솔의 NAVER API HUB에서 Application 등록 후 인증 정보)
NAVER_CLIENT_ID=~
NAVER_CLIENT_SECRET=~

# 이하 선택

# Wikipedia API 요청에 사용할 User-Agent
WIKIKIT_USER_AGENT="WikiKit/1.0 (+https://github.com/~; contact: ~@~.com)"

# RAG 벡터 저장 경로와 PDF 업로드 경로 (상대 경로는 ai/ 기준)
RAG_PERSIST_DIR=server_storage/chroma_data
# RAG_UPLOAD_DIR=server_storage/uploads

# 강의 자료 분할 방식 (기본값: semantic). page | recursive | semantic
# RAG_CHUNK_STRATEGY=semantic

# LLM 모델 (기본값: gpt-6-luna). 용도별 LLM_SUMMARY_MODEL, LLM_QA_MODEL 등도 가능
# LLM_MODEL=gpt-6-luna
